rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Verifica se o usuário autenticado é dono do business
    function isBusinessOwner(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId));
      return biz.data.ownerUid == request.auth.uid;
    }

    // Verifica se o usuário é membro do business (owner ou staff)
    function isBusinessMember(businessId) {
      return isBusinessOwner(businessId) ||
             exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid));
    }

    // ===== /users/{userId} — perfil do usuário =====
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // ===== /businesses/{businessId} — entidade multi-tenant =====
    match /businesses/{businessId} {
      // Apenas o owner pode ler/atualizar o business
      allow read: if isSignedIn() && isBusinessMember(businessId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isBusinessOwner(businessId);
      allow delete: if isSignedIn() && isBusinessOwner(businessId);

      // --- Clientes ---
      match /clients/{clientId} {
        allow read, write: if isSignedIn() && isBusinessMember(businessId);
        // Validar limite de clientes ao criar
        allow create: if isSignedIn()
                      && isBusinessMember(businessId)
                      && validateClientLimit(businessId);
      }

      // --- Atendimentos (appointments) ---
      match /appointments/{appointmentId} {
        allow read, write: if isSignedIn() && isBusinessMember(businessId);
      }

      // --- Serviços oferecidos ---
      match /services/{serviceId} {
        allow read, write: if isSignedIn() && isBusinessMember(businessId);
      }

      // --- Pacotes ---
      match /packages/{packageId} {
        allow read, write: if isSignedIn() && isBusinessMember(businessId);
      }

      // --- Transações financeiras ---
      match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && isBusinessMember(businessId);
      }

      // --- Staff / profissionais adicionais ---
      match /staff/{staffUid} {
        allow read: if isSignedIn() && isBusinessMember(businessId);
        allow write: if isSignedIn() && isBusinessOwner(businessId);
      }
    }

    // ===== Função: validar limite de clientes por plano =====
    function validateClientLimit(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId));
      let plan = biz.data.plan;
      // Nota: Firestore rules não suportam count() nativo.
      // A validação real de limite deve ser feita no backend (Cloud Functions).
      // Aqui permitimos a criação e delegamos o enforcement ao servidor.
      return plan == 'starter' || plan == 'pro' || plan == 'clinic';
    }
  }
}
