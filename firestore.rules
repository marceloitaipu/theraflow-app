rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Valida que os dados que estão sendo escritos pertencem ao próprio usuário.
    // Todas as subcoleções devem conter um campo userId igual ao uid autenticado.
    function ownsDocument() {
      return request.resource.data.userId == request.auth.uid;
    }

    // ===== /users/{userId} — perfil do usuário + dados isolados =====
    //
    // Arquitetura: single-tenant. Cada usuário tem suas subcoleções.
    // O IncrementalSyncService grava em users/{uid}/{clients|sessions|payments|packages}.
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);

      match /clients/{clientId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && ownsDocument();
        allow update, delete: if isSignedIn() && isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && ownsDocument();
        allow update, delete: if isSignedIn() && isOwner(userId);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && ownsDocument();
        allow update, delete: if isSignedIn() && isOwner(userId);
      }

      match /packages/{packageId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && ownsDocument();
        allow update, delete: if isSignedIn() && isOwner(userId);
      }

      // Registro de violações (escrito apenas por Cloud Functions).
      match /violations/{violationId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow write: if false;
      }
    }

    // Qualquer outro caminho é negado por padrão.
  }
}
